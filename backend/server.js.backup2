// Add multer configuration for file uploads
const multer = require('multer');
const path = require('path');

// Configure storage
const storage = multer.diskStorage({
    destination: function (req, file, cb) {
        cb(null, 'uploads/')
    },
    filename: function (req, file, cb) {
        const uniqueSuffix = Date.now() + '-' + Math.round(Math.random() * 1E9);
        cb(null, uniqueSuffix + path.extname(file.originalname));
    }
});

// File filter
const fileFilter = (req, file, cb) => {
    const allowedTypes = ['image/jpeg', 'image/png', 'image/jpg', 'image/gif', 'application/pdf'];
    if (allowedTypes.includes(file.mimetype)) {
        cb(null, true);
    } else {
        cb(new Error('Invalid file type. Only JPEG, PNG, GIF, and PDF are allowed.'), false);
    }
};

const upload = multer({ 
    storage: storage,
    limits: { fileSize: 5 * 1024 * 1024 }, // 5MB limit
    fileFilter: fileFilter
});

// Serve uploaded files statically
app.use('/uploads', express.static('uploads'));

// Update the submit request endpoint to handle files
app.post('/api/requests', authenticateToken, upload.array('attachments', 5), async (req, res) => {
pi/requests, authenticateToken, upload.array/,/});/c
    try {
        const { category_id, title, description, location_address, location_lat, location_lng, is_anonymous, priority } = req.body;
        
        // Generate unique reference number
        const refNum = 'SCR' + Date.now().toString().slice(-8) + Math.floor(Math.random() * 1000);
        
        // Insert request
        const result = await query(
            `INSERT INTO requests (reference_number, citizen_id, category_id, title, description, 
             location_address, location_latitude, location_longitude, is_anonymous, priority, status) 
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'open')`,
            [refNum, req.user.userId, category_id, title, description, location_address, location_lat, location_lng, is_anonymous || 0, priority || 'medium']
        );
        
        // Save attachments if any
        const requestId = result.insertId;
        if (req.files && req.files.length > 0) {
            for (const file of req.files) {
                const fileUrl = `/uploads/${file.filename}`;
                await query(
                    `INSERT INTO request_attachments (request_id, file_url, file_name, file_size, mime_type) 
                     VALUES (?, ?, ?, ?, ?)`,
                    [requestId, fileUrl, file.originalname, file.size, file.mimetype]
                );
            }
        }
        
        res.status(201).json({
            success: true,
            message: 'Request submitted successfully with ' + (req.files?.length || 0) + ' attachments',
            reference_number: refNum,
            requestId: requestId,
            attachments: req.files?.length || 0
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: error.message });
    }
});

// Add endpoint to get attachments for a request
app.get('/api/requests/:id/attachments', authenticateToken, async (req, res) => {
