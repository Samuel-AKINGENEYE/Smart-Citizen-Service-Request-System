    } else {
        console.log('✅ Connected to MySQL database');
    }
});

// Promisify db query
const query = (sql, params) => {
    return new Promise((resolve, reject) => {
        db.query(sql, params, (err, results) => {
            if (err) reject(err);
            else resolve(results);
        });
    });
};

