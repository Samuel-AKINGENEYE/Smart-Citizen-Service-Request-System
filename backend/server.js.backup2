// Submit a new request
app.post('/api/requests', authenticateToken, async (req, res) => {
pi/requests, authenticateToken, upload.array/,/});/c
    try {
        const { category_id, title, description, location_address, location_lat, location_lng, is_anonymous, priority } = req.body;
        
        const refNum = 'SCR' + Date.now().toString().slice(-8) + Math.floor(Math.random() * 1000);
        
        const result = await query(
            `INSERT INTO requests (reference_number, citizen_id, category_id, title, description, 
             location_address, location_latitude, location_longitude, is_anonymous, priority, status) 
             VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'open')`,
            [refNum, req.user.userId, category_id, title, description, location_address, location_lat, location_lng, is_anonymous || 0, priority || 'medium']
        );
        
        res.status(201).json({
            success: true,
            message: 'Request submitted successfully',
            reference_number: refNum,
            requestId: result.insertId
        });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: error.message });
    }
});

// Get my requests
app.get('/api/requests/my-requests', authenticateToken, async (req, res) => {
    try {
        const requests = await query(
            `SELECT r.*, c.name as category_name 
             FROM requests r 
             JOIN categories c ON r.category_id = c.id 
             WHERE r.citizen_id = ? 
             ORDER BY r.created_at DESC`,
            [req.user.userId]
        );
        res.json({ success: true, requests });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Get single request
app.get('/api/requests/:id', authenticateToken, async (req, res) => {
    try {
        const requests = await query(
            `SELECT r.*, c.name as category_name, u.full_name as citizen_name 
             FROM requests r 
             JOIN categories c ON r.category_id = c.id 
             JOIN users u ON r.citizen_id = u.id 
             WHERE r.id = ?`,
            [req.params.id]
        );
        
        if (requests.length === 0) {
            return res.status(404).json({ success: false, message: 'Request not found' });
        }
        
        res.json({ success: true, request: requests[0] });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

