// Admin: Get all requests
app.get('/api/admin/requests', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin', 'field_officer'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const requests = await query(
            `SELECT r.*, c.name as category_name, u.full_name as citizen_name, u.email as citizen_email
             FROM requests r 
             JOIN categories c ON r.category_id = c.id 
             JOIN users u ON r.citizen_id = u.id 
             ORDER BY r.created_at DESC`
        );
        res.json({ success: true, requests });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Admin: Update request status
app.put('/api/admin/requests/:id/status', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin', 'field_officer'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const { status, comment } = req.body;
        
        await query(
            `UPDATE requests SET status = ?, updated_at = NOW() WHERE id = ?`,
            [status, req.params.id]
        );
        
        res.json({ success: true, message: 'Status updated successfully' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Admin: Get statistics
app.get('/api/admin/stats', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const total = await query('SELECT COUNT(*) as count FROM requests');
        const open = await query('SELECT COUNT(*) as count FROM requests WHERE status = "open"');
        const inProgress = await query('SELECT COUNT(*) as count FROM requests WHERE status = "in_progress"');
        const resolved = await query('SELECT COUNT(*) as count FROM requests WHERE status = "resolved"');
        
        res.json({
            success: true,
            stats: {
                total: total[0].count,
                open: open[0].count,
                inProgress: inProgress[0].count,
                resolved: resolved[0].count
            }
        });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

