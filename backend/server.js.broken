// SCRS-015: Rate and review resolved request
app.post('/api/requests/:id/rate', authenticateToken, async (req, res) => {
    try {
        const { rating, review } = req.body;
        const requestId = req.params.id;
        
        if (rating < 1 || rating > 5) {
            return res.status(400).json({ success: false, message: 'Rating must be between 1 and 5' });
        }
        
        const [request] = await query(
            'SELECT id, status, citizen_id FROM requests WHERE id = ?',
            [requestId]
        );
        
        if (!request) {
            return res.status(404).json({ success: false, message: 'Request not found' });
        }
        
        if (request.citizen_id !== req.user.userId) {
            return res.status(403).json({ success: false, message: 'You can only rate your own requests' });
        }
        
        if (request.status !== 'resolved') {
            return res.status(400).json({ success: false, message: 'Only resolved requests can be rated' });
        }
        
        // Insert or update rating
        await query(
            `INSERT INTO request_ratings (request_id, user_id, rating, review) 
             VALUES (?, ?, ?, ?) 
             ON DUPLICATE KEY UPDATE rating = ?, review = ?`,
            [requestId, req.user.userId, rating, review, rating, review]
        );
        
        // Update average rating in requests table
        await query(
            `UPDATE requests r 
             SET rating = (SELECT AVG(rating) FROM request_ratings WHERE request_id = ?)
             WHERE r.id = ?`,
            [requestId, requestId]
        );
        
        res.json({ success: true, message: 'Thank you for your feedback!' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Get average rating for department
app.get('/api/admin/department-rating', authenticateToken, async (req, res) => {
    try {
        const ratings = await query(
            `SELECT d.name as department, AVG(rr.rating) as avg_rating, COUNT(rr.id) as total_reviews
             FROM departments d
             JOIN categories c ON c.department_id = d.id
             JOIN requests r ON r.category_id = c.id
             JOIN request_ratings rr ON rr.request_id = r.id
             GROUP BY d.id`
        );
        res.json({ success: true, ratings });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// SCRS-021: Search requests with filters
app.get('/api/admin/requests/search', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin', 'field_officer'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const { status, category, priority, date_from, date_to, search } = req.query;
        let sql = `
            SELECT r.*, c.name as category_name, u.full_name as citizen_name, u.email as citizen_email
            FROM requests r 
            JOIN categories c ON r.category_id = c.id 
            JOIN users u ON r.citizen_id = u.id 
            WHERE 1=1
        `;
        const params = [];
        
        if (status) {
            sql += ' AND r.status = ?';
            params.push(status);
        }
        if (category) {
            sql += ' AND r.category_id = ?';
            params.push(category);
        }
        if (priority) {
            sql += ' AND r.priority = ?';
            params.push(priority);
        }
        if (date_from) {
            sql += ' AND DATE(r.created_at) >= ?';
            params.push(date_from);
        }
        if (date_to) {
            sql += ' AND DATE(r.created_at) <= ?';
            params.push(date_to);
        }
        if (search) {
            sql += ' AND (r.reference_number LIKE ? OR r.title LIKE ? OR u.full_name LIKE ?)';
            const searchTerm = `%${search}%`;
            params.push(searchTerm, searchTerm, searchTerm);
        }
        
        sql += ' ORDER BY r.created_at DESC';
        
        const requests = await query(sql, params);
        res.json({ success: true, requests });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});
const { Parser } = require('json2csv');

// SCRS-024: Export requests to CSV
app.get('/api/admin/export/csv', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const requests = await query(
            `SELECT r.reference_number, r.title, r.description, r.status, r.priority, 
             r.created_at, r.resolved_at, c.name as category, u.full_name as citizen_name
             FROM requests r
             JOIN categories c ON r.category_id = c.id
             JOIN users u ON r.citizen_id = u.id
             ORDER BY r.created_at DESC`
        );
        
        const fields = ['reference_number', 'title', 'description', 'status', 'priority', 
                       'category', 'citizen_name', 'created_at', 'resolved_at'];
        const parser = new Parser({ fields });
        const csv = parser.parse(requests);
        
        res.header('Content-Type', 'text/csv');
        res.attachment(`scrs_export_${Date.now()}.csv`);
        res.send(csv);
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// SCRS-022: Update priority for urgent requests
app.put('/api/admin/requests/:id/priority', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin', 'field_officer'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const { priority } = req.body;
        const validPriorities = ['low', 'medium', 'high', 'urgent'];
        
        if (!validPriorities.includes(priority)) {
            return res.status(400).json({ success: false, message: 'Invalid priority' });
        }
        
        await query(
            'UPDATE requests SET priority = ?, updated_at = NOW() WHERE id = ?',
            [priority, req.params.id]
        );
        
        // If urgent, notify assigned officer (SMS/email would go here)
        if (priority === 'urgent') {
            console.log(`🚨 Urgent request #${req.params.id} flagged for immediate attention`);
        }
        
        res.json({ success: true, message: `Priority updated to ${priority}` });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// SCRS-014: Cancel/withdraw request
app.put('/api/requests/:id/cancel', authenticateToken, async (req, res) => {
    try {
        const [request] = await query(
            'SELECT id, status, citizen_id FROM requests WHERE id = ?',
            [req.params.id]
        );
        
        if (!request) {
            return res.status(404).json({ success: false, message: 'Request not found' });
        }
        
        if (request.citizen_id !== req.user.userId && req.user.role === 'citizen') {
            return res.status(403).json({ success: false, message: 'Not authorized to cancel this request' });
        }
        
        if (request.status !== 'open') {
            return res.status(400).json({ success: false, message: 'Only open requests can be cancelled' });
        }
        
        await query(
            'UPDATE requests SET status = "rejected", updated_at = NOW() WHERE id = ?',
            [req.params.id]
        );
        
        res.json({ success: true, message: 'Request cancelled successfully' });
    } catch (error) {
        console.error(error);
        res.status(500).json({ success: false, message: error.message });
    }
});

