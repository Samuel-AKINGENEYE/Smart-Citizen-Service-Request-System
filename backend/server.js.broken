// SCRS-022: Update priority for urgent requests
app.put('/api/admin/requests/:id/priority', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin', 'field_officer'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const { priority } = req.body;
        const validPriorities = ['low', 'medium', 'high', 'urgent'];
        
        if (!validPriorities.includes(priority)) {
            return res.status(400).json({ success: false, message: 'Invalid priority' });
        }
        
        await query(
            'UPDATE requests SET priority = ?, updated_at = NOW() WHERE id = ?',
            [priority, req.params.id]
        );
        
        if (priority === 'urgent') {
            console.log(`🚨 Urgent request #${req.params.id} flagged for immediate attention`);
        }
        
        res.json({ success: true, message: `Priority updated to ${priority}` });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// SCRS-024: Export requests to CSV
const { Parser } = require('json2csv');

app.get('/api/admin/export/csv', authenticateToken, async (req, res) => {
    const adminRoles = ['super_admin', 'department_admin'];
    if (!adminRoles.includes(req.user.role)) {
        return res.status(403).json({ success: false, message: 'Admin access required' });
    }
    
    try {
        const requests = await query(
            `SELECT r.reference_number, r.title, r.description, r.status, r.priority, 
             r.created_at, r.resolved_at, c.name as category, u.full_name as citizen_name, u.email as citizen_email
             FROM requests r
             JOIN categories c ON r.category_id = c.id
             JOIN users u ON r.citizen_id = u.id
             ORDER BY r.created_at DESC`
        );
        
        const fields = ['reference_number', 'title', 'description', 'status', 'priority', 
                       'category', 'citizen_name', 'citizen_email', 'created_at', 'resolved_at'];
        const parser = new Parser({ fields });
        const csv = parser.parse(requests);
        
        res.header('Content-Type', 'text/csv');
        res.attachment(`scrs_export_${Date.now()}.csv`);
        res.send(csv);
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});
