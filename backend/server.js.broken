    }
});

// SCRS-014: Cancel/withdraw request
app.put('/api/requests/:id/cancel', authenticateToken, async (req, res) => {
    try {
        const [request] = await query('SELECT id, status, citizen_id FROM requests WHERE id = ?', [req.params.id]);
        if (!request) return res.status(404).json({ success: false, message: 'Request not found' });
        if (request.citizen_id !== req.user.userId && req.user.role === 'citizen') {
            return res.status(403).json({ success: false, message: 'Not authorized' });
        }
        if (request.status !== 'open') {
            return res.status(400).json({ success: false, message: 'Only open requests can be cancelled' });
        }
        await query('UPDATE requests SET status = "rejected", updated_at = NOW() WHERE id = ?', [req.params.id]);
        await query('INSERT INTO request_timeline (request_id, user_id, action, old_status, new_status, comment) VALUES (?, ?, "cancelled", ?, "rejected", "Request cancelled by user")', [req.params.id, req.user.userId, request.status]);
        res.json({ success: true, message: 'Request cancelled successfully' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

